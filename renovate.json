{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Nasus20202/renovate"],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "description": "The example docker-compose intentionally uses the floating latest tag of our own image; do not pin its digest",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/nasus20202/atu-website"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the corepack version pinned in Dockerfile ARG via a renovate annotation",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*ARG\\s+\\w+=(?<currentValue>[^\\s]+)"
      ]
    }
  ]
}
